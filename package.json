{
  "name": "theprawnsplit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run test:core && npm run test:sync && npm run lint:money && npm run check && vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint:money": "node scripts/lint-money.mjs",
    "test:sync": "vitest run --config vitest.config.ts --dir .",
    "test:core": "npm --prefix core test",
    "preview": "vite preview"
  },
  "dependencies": {
    "@lucide/svelte": "^1.33.0",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@upstash/redis": "^1.38.2",
    "idb": "^8.0.0",
    "nostr-tools": "^2.24.3",
    "qrcode": "^1.5.4",
    "svelte": "^5.16.0",
    "vite": "^6.0.7"
  },
  "devDependencies": {
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^22.20.1",
    "@types/qrcode": "^1.5.6",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^3.23.2",
    "svelte-check": "^4.1.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
